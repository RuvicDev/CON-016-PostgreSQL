{
  "id": "postgresql",
  "name": "PostgreSQL",
  "name_en": "PostgreSQL",
  "version": "1.0.0",
  "description": "Consulta de solo lectura a bases de datos PostgreSQL: tablas, datos, estadísticas y plan de ejecución de queries",
  "description_en": "Read-only queries against PostgreSQL databases: tables, data, statistics and query execution plans",
  "icon": "icon.svg",
  "category": "database",
  "category_en": "database",
  "keywords": ["postgresql", "postgres", "sql", "database", "base de datos", "solo lectura", "read-only"],
  "library": {
    "package": "ruvic-postgresql-connector",
    "install": "pip install git+https://github.com/Dgirto/PostgreSQL.git#subdirectory=lib",
    "import_name": "ruvic_postgresql_connector"
  },
  "auth_modes": [
    {
      "id": "user_password",
      "label": "Usuario y contraseña",
      "fields": [
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "required": true,
          "placeholder": "db.empresa.com",
          "help_text": "Hostname o IP del servidor PostgreSQL"
        },
        {
          "key": "port",
          "label": "Puerto",
          "type": "number",
          "required": true,
          "default": "5432"
        },
        {
          "key": "database",
          "label": "Base de datos",
          "type": "text",
          "required": true,
          "placeholder": "produccion"
        },
        {
          "key": "username",
          "label": "Usuario",
          "type": "text",
          "required": true,
          "help_text": "Se recomienda un usuario de solo lectura"
        },
        {
          "key": "password",
          "label": "Contraseña",
          "type": "password",
          "secret": true,
          "required": true
        },
        {
          "key": "connect_timeout",
          "label": "Timeout de conexión (segundos)",
          "type": "number",
          "required": false,
          "default": "10"
        }
      ]
    }
  ],
  "env_prefix": "RUVIC_POSTGRESQL_",
  "operations": ["db.list_tables", "db.read", "db.stats", "db.explain"],
  "test_connection": true,
  "docs": {
    "skill": "SKILL.md",
    "permissions_note": "El usuario necesita CONNECT sobre la base de datos, USAGE sobre el esquema y SELECT sobre las tablas a consultar. No se requieren permisos de escritura ni de administración."
  }
}
